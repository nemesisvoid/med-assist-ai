# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, RDS, local Postgres, `npx prisma dev`, ...)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ─── Auth (Better Auth) ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public URL of this Next.js app (used for auth callbacks and email links)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Google sign-in. The "Continue with Google" button only appears when both are set.
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Email (verification, password reset, staff invites) ─────────────────────
# Configure ONE provider. Resend is used if set, otherwise SMTP. In development,
# if neither is set, emails (including their links) are printed to the server console.
EMAIL_FROM="MedAssist AI <no-reply@yourdomain.com>"

# Option A: Resend (https://resend.com). Requires a domain you have verified in Resend.
RESEND_API_KEY=""

# Option B: SMTP via Nodemailer, e.g. Gmail with an app password
# (Google Account → Security → 2-Step Verification → App passwords).
# For Gmail, EMAIL_FROM must use the same address as SMTP_USER (or leave EMAIL_FROM empty).
SMTP_HOST=""          # smtp.gmail.com
SMTP_PORT="465"       # 465 = implicit TLS, 587 = STARTTLS
SMTP_USER=""          # you@gmail.com
SMTP_PASS=""          # 16-character app password, not your normal password
# SMTP_SECURE=""      # optional: "false" allows unencrypted SMTP (local mail catchers like Mailpit only)

# Set to "console" to print emails instead of sending them (local testing only)
# EMAIL_TRANSPORT="console"

# ─── AI ──────────────────────────────────────────────────────────────────────
# Google Gemini API key used for risk analysis, SOAP drafts and patient summaries
GEMINI_API_KEY=""

# ─── Realtime messaging ──────────────────────────────────────────────────────
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
SOCKET_PORT="3001"
# Shared secret used to sign chat connection tokens. Set the SAME value on the
# Next.js app (Vercel) and the socket server (Render). Generate with: openssl rand -base64 32
SOCKET_AUTH_SECRET=""

# ─── Chat attachments (Cloudflare R2, private bucket) ────────────────────────
# Needed on the Next.js app only (not on the socket server). Without these,
# messaging still works but the attach buttons report that file sharing is off.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Optional: any other S3-compatible endpoint instead of R2 (e.g. a local emulator)
# R2_ENDPOINT=""
